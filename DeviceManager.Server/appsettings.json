{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:8082",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://0.0.0.0:8083",
        "Protocols": "Http2"
      }
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Data Source=data.db;Cache=Shared;Pooling=True"
  },

  "Auth": {
    "ExpireMinutes": 1440,
    "InitialId": "admin",
    "InitialPassword": "admin"
  },

  "Device": {
    "ApiKey": "device-manager-api-key-0123456789",
    "LowBatteryThreshold": 20
  },

  "Storage": {
    "Root": "storage"
  },

  "Cleanup": {
    "Enable": true,
    "IntervalSeconds": 3600,
    "RetentionDays": 30
  },

  "Log": {
    "HttpLog": false
  },

  "Profiler": {
    "SqlLog": {
      "Enable": false,
      "OutputParameter": true,
      "ElapsedThresholdMilliseconds": 0
    },
    "SqlTelemetry": {
      "Enable": false
    }
  },

  "Prometheus": {
    "Uri": "http://0.0.0.0:9464"
  },

  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../log/DeviceManager.Server_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} {MachineName} [{SourceContext}] [{ThreadId}] {TraceId} {RequestId} {RequestPath} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
