@page "/"
@attribute [Authorize]
@inherits AppComponentBase

<PageTitle>ダッシュボード</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">ダッシュボード</MudText>

@* サマリーカード *@
<MudGrid Class="mb-2">
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4" Style="border-bottom: 4px solid var(--mud-palette-success);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudText Typo="Typo.subtitle2">稼働(日) @now.ToString("MM/dd")</MudText>
                    <MudText Typo="Typo.h4">@summary.ActiveDay / @summary.Total</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.Today" Size="Size.Large" Color="Color.Success" />
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4" Style="border-bottom: 4px solid var(--mud-palette-info);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudText Typo="Typo.subtitle2">稼働(週) @now.AddDays(-6).ToString("MM/dd")〜</MudText>
                    <MudText Typo="Typo.h4">@summary.ActiveWeek / @summary.Total</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.DateRange" Size="Size.Large" Color="Color.Info" />
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4" Style="border-bottom: 4px solid var(--mud-palette-warning);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudText Typo="Typo.subtitle2">バッテリー小</MudText>
                    <MudText Typo="Typo.h4">@summary.LowBattery / @summary.Total</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.BatteryAlert" Size="Size.Large" Color="Color.Warning" />
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" md="3">
        <MudPaper Class="pa-4" Style="border-bottom: 4px solid var(--mud-palette-error);">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <div>
                    <MudText Typo="Typo.subtitle2">警告 / 異常</MudText>
                    <MudText Typo="Typo.h4">@summary.Warning / @summary.Error</MudText>
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

@* ツールバー *@
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudTextField @bind-Value="searchText"
                  Label="検索(ID / 名称 / グループ)"
                  Clearable="true"
                  Immediate="true"
                  OnKeyDown="OnSearchKeyDown"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Style="max-width: 320px;" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchAsync">検索</MudButton>
    <MudSpacer />
    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="ReloadAsync" />
    <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
        <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="AddAsync">端末の追加</MudMenuItem>
    </MudMenu>
</MudStack>

@* 端末リスト *@
<MudTable Items="devices" Dense="true" Hover="true" Breakpoint="Breakpoint.None" Style="overflow-x: auto;">
    <HeaderContent>
        <MudTh Style="width: 60px;">状態</MudTh>
        <MudTh>名称</MudTh>
        <MudTh Style="width: 90px;">電波</MudTh>
        <MudTh>AP名</MudTh>
        <MudTh Style="width: 100px;">バッテリー</MudTh>
        <MudTh Style="width: 60px;">移動</MudTh>
        <MudTh Style="width: 60px;">位置</MudTh>
        <MudTh Style="width: 90px;">スキャン</MudTh>
        <MudTh Style="width: 110px;">最終更新</MudTh>
        <MudTh Style="width: 110px;">進捗1</MudTh>
        <MudTh Style="width: 110px;">進捗2</MudTh>
        <MudTh Style="width: 80px;">ログ</MudTh>
        <MudTh Style="width: 100px;">操作</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            <MudTooltip Text="@ViewHelper.StateText(context.Status)">
                <MudIcon Icon="@Icons.Material.Filled.Smartphone" Color="@ViewHelper.StateColor(context.Status)" Style="@(context.IsEnabled == 0 ? "opacity: 0.3;" : null)" />
            </MudTooltip>
        </MudTd>
        <MudTd>
            <MudText Typo="Typo.body2">@context.Name</MudText>
            <MudText Typo="Typo.caption" Style="opacity: 0.6;">@context.DeviceId @(String.IsNullOrEmpty(context.GroupName) ? string.Empty : $"[{context.GroupName}]")</MudText>
        </MudTd>
        <MudTd>
            <MudIcon Icon="@ViewHelper.WifiIcon(context.WifiRssi)" Color="@ViewHelper.WifiColor(context.WifiRssi)" Size="Size.Small" />
            <MudText Typo="Typo.caption">@(context.WifiRssi is null ? "-" : $"{context.WifiRssi}dB")</MudText>
        </MudTd>
        <MudTd>@(context.ApName ?? "-")</MudTd>
        <MudTd>
            <MudIcon Icon="@ViewHelper.BatteryIcon(context.Battery)" Color="@ViewHelper.BatteryColor(context.Battery)" Size="Size.Small" />
            <MudText Typo="Typo.caption">@(context.Battery is null ? "-" : $"{context.Battery:F0}%")</MudText>
        </MudTd>
        <MudTd>
            @if (context.Moving == 1)
            {
                <MudIcon Icon="@Icons.Material.Filled.DirectionsWalk" Color="Color.Info" Size="Size.Small" />
            }
            else
            {
                <MudText Typo="Typo.caption">-</MudText>
            }
        </MudTd>
        <MudTd>
            @if (context.Latitude is not null && context.Longitude is not null)
            {
                <MudTooltip Text="@($"{context.Latitude:F6}, {context.Longitude:F6}")">
                    <MudIcon Icon="@Icons.Material.Filled.Place" Color="Color.Info" Size="Size.Small" />
                </MudTooltip>
            }
            else
            {
                <MudText Typo="Typo.caption">-</MudText>
            }
        </MudTd>
        <MudTd>@(context.ScanCount is null ? "-" : $"{context.ScanCount:N0}")</MudTd>
        <MudTd>@ViewHelper.RelativeTime(context.StatusUpdatedAt ?? context.LastConnectedAt, now)</MudTd>
        <MudTd>
            <MudProgressLinear Value="@(context.Progress1 ?? 0)" Color="Color.Primary" />
            <MudText Typo="Typo.caption">@(context.Progress1 is null ? "-" : $"{context.Progress1:F0}%")</MudText>
        </MudTd>
        <MudTd>
            <MudProgressLinear Value="@(context.Progress2 ?? 0)" Color="Color.Success" />
            <MudText Typo="Typo.caption">@(context.Progress2 is null ? "-" : $"{context.Progress2:F0}%")</MudText>
        </MudTd>
        <MudTd>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => ShowLogsAsync(context)">@context.LogCount 件</MudButton>
        </MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAsync(context)" />
            <AuthorizeView Roles="@Roles.Administrator" Context="auth">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" />
            </AuthorizeView>
        </MudTd>
    </RowTemplate>
</MudTable>
