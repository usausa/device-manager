<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="Form">
            <MudTextField @bind-Value="Form.Name"
                          For="@(() => Form.Name)"
                          Validation="@Validator.ValidateValue"
                          Label="名前"
                          MaxLength="@Length.FunctionName"
                          Disabled="@(!IsNew)"
                          Immediate="true" />
            <MudTextField @bind-Value="Form.Json"
                          For="@(() => Form.Json)"
                          Validation="@Validator.ValidateValue"
                          Label="JSON"
                          Lines="12"
                          Immediate="true"
                          Class="mt-4"
                          Style="font-family: monospace;" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="OnOkClick">OK</MudButton>
        <MudButton Color="Color.Default" OnClick="OnCancelClick">CANCEL</MudButton>
    </DialogActions>
</MudDialog>
