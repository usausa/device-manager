<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">ログ - @DeviceName</MudText>
    </TitleContent>
    <DialogContent>
        <MudTable Items="logs" Dense="true" Hover="true" Style="max-height: 480px; overflow-y: auto;">
            <HeaderContent>
                <MudTh Style="width: 140px;">時刻</MudTh>
                <MudTh Style="width: 90px;">レベル</MudTh>
                <MudTh Style="width: 160px;">カテゴリ</MudTh>
                <MudTh>メッセージ</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.CreatedAt.ToString("MM/dd HH:mm:ss")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@ViewHelper.LogLevelColor(context.Level)">@ViewHelper.LogLevelText(context.Level)</MudChip>
                </MudTd>
                <MudTd Style="word-break: break-all;">@context.Category</MudTd>
                <MudTd Style="word-break: break-all;">
                    @context.Message
                    @if (!String.IsNullOrEmpty(context.Exception))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Error" Style="white-space: pre-wrap;">@context.Exception</MudText>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
        @if (logs.Count == 0)
        {
            <MudText Class="mt-2" Typo="Typo.body2">ログはありません。</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Href="@($"logs?deviceId={Uri.EscapeDataString(DeviceId)}")">ログ画面へ</MudButton>
        <MudButton Color="Color.Default" OnClick="OnCloseClick">閉じる</MudButton>
    </DialogActions>
</MudDialog>
