<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Title</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" Model="Form">
            <MudTextField @bind-Value="Form.Key"
                          For="@(() => Form.Key)"
                          Validation="@Validator.ValidateValue"
                          Label="キー"
                          MaxLength="@Length.Key"
                          Disabled="@(!IsNew)"
                          Immediate="true" />
            <MudTextField @bind-Value="Form.Value"
                          For="@(() => Form.Value)"
                          Validation="@Validator.ValidateValue"
                          Label="値"
                          MaxLength="@Length.Value"
                          Immediate="true"
                          Class="mt-4" />
            <MudTextField @bind-Value="Form.Description"
                          For="@(() => Form.Description)"
                          Validation="@Validator.ValidateValue"
                          Label="説明"
                          MaxLength="@Length.Description"
                          Immediate="true"
                          Class="mt-4" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="OnOkClick">OK</MudButton>
        <MudButton Color="Color.Default" OnClick="OnCancelClick">CANCEL</MudButton>
    </DialogActions>
</MudDialog>
