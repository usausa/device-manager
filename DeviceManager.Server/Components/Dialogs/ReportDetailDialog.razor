<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">エラーレポート詳細</MudText>
    </TitleContent>
    <DialogContent>
        <MudSimpleTable Dense="true">
            <tbody>
                <tr><td style="width: 140px;">レポートID</td><td>@Report.ReportId</td></tr>
                <tr><td>端末</td><td>@Report.DeviceId</td></tr>
                <tr><td>例外種別</td><td>@Report.ExceptionType</td></tr>
                <tr><td>メッセージ</td><td style="word-break: break-all;">@Report.Message</td></tr>
                <tr><td>アプリ / OS</td><td>@(Report.AppVersion ?? "-") / @(Report.OsVersion ?? "-")</td></tr>
                <tr><td>発生 / 受信</td><td>@Report.OccurredAt.ToString("yyyy/MM/dd HH:mm:ss") / @Report.ReceivedAt.ToString("yyyy/MM/dd HH:mm:ss")</td></tr>
            </tbody>
        </MudSimpleTable>
        @if (!String.IsNullOrEmpty(Report.StackTrace))
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4">スタックトレース</MudText>
            <MudPaper Outlined="true" Class="pa-2" Style="max-height: 240px; overflow: auto;">
                <pre style="margin: 0; font-size: 12px;">@Report.StackTrace</pre>
            </MudPaper>
        }
        @if (!String.IsNullOrEmpty(Report.InnerException))
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4">内部例外</MudText>
            <MudPaper Outlined="true" Class="pa-2" Style="max-height: 160px; overflow: auto;">
                <pre style="margin: 0; font-size: 12px;">@Report.InnerException</pre>
            </MudPaper>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Default" OnClick="OnCloseClick">閉じる</MudButton>
    </DialogActions>
</MudDialog>
